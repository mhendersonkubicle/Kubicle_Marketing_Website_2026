# ============================================================
# Kubicle.com response headers (Netlify + Cloudflare Pages)
# ============================================================
# This file ships at the site root in /dist (build.js copies it through
# unchanged). It is read by BOTH Netlify and Cloudflare Pages, in
# addition to any header rules in netlify.toml. The rules here are
# written in the shared `_headers` syntax so both platforms apply them
# identically.
#
# Format:
#   <path-pattern>
#     <Header-Name>: <value>
#     <Header-Name>: <value>
#
# More-specific rules win. `/*` matches everything; subpath rules add or
# override specific headers for matching paths.
#
# Keep in sync with netlify.toml [[headers]] blocks. If you change a
# rule here, change it there too (or vice versa) so both platforms emit
# identical responses.
# ============================================================


# ------------------------------------------------------------
# Security headers (apply to every response)
# ------------------------------------------------------------
/*
  X-Frame-Options: SAMEORIGIN
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Cross-Origin-Opener-Policy: same-origin-allow-popups


# ------------------------------------------------------------
# Caching: HTML, short cache so content edits propagate quickly
# ------------------------------------------------------------
/*.html
  Cache-Control: public, max-age=0, must-revalidate


# ------------------------------------------------------------
# Caching: CSS / JS, moderate cache for non-fingerprinted shared assets
# ------------------------------------------------------------
/shared/styles/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/blog/blog.css
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/blog/blog.js
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800


# ------------------------------------------------------------
# Caching: Images, long cache (filenames are hash-prefixed)
# ------------------------------------------------------------
/img/*
  Cache-Control: public, max-age=31536000, immutable

/blog/img/*
  Cache-Control: public, max-age=31536000, immutable

/courses/img/*
  Cache-Control: public, max-age=31536000, immutable

/academies/*/img/*
  Cache-Control: public, max-age=31536000, immutable


# ------------------------------------------------------------
# Fonts (if served locally under any academy's /fonts/ folder)
# ------------------------------------------------------------
/academies/*/fonts/*
  Cache-Control: public, max-age=31536000, immutable


# ------------------------------------------------------------
# Sitemap + robots, short cache so SEO updates propagate same day
# ------------------------------------------------------------
/sitemap.xml
  Cache-Control: public, max-age=3600
  Content-Type: application/xml; charset=utf-8

/robots.txt
  Cache-Control: public, max-age=3600


# ------------------------------------------------------------
# Case study PDFs, long cache (filenames are content-hashed)
# ------------------------------------------------------------
/Case_Study_pdfs/*
  Cache-Control: public, max-age=2592000
  Content-Type: application/pdf
